APP_NAME="Dr. Serap Özdamar"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=__APP_URL__
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
LOG_CHANNEL=single
LOG_LEVEL=warning

# --- Veritabanı: İHS panelinde "Mysql Yönetimi"nden oluşturduğunuz bilgileri yazın ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=BURAYA_VERITABANI_ADI
DB_USERNAME=BURAYA_KULLANICI_ADI
DB_PASSWORD=BURAYA_SIFRE

SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Tek seferlik kurulum anahtarı (kurulumdan sonra bu satırı silin)
INSTALL_TOKEN=__INSTALL_TOKEN__
